  <String Id="LaunchApp">Запустить Aureon</String>
  <String Id="DowngradeErrorMessage">Уже установлена более новая версия Aureon.</String>
  <String Id="WelcomeDlgTitle">{\WixUI_Font_Bigger}Вас приветствует мастер установки Aureon</String>
  <String Id="WelcomeDlgDescription">Мастер установит [ProductName] на ваш компьютер. Нажмите «Далее», чтобы продолжить, или «Отмена», чтобы выйти.</String>
  <String Id="ExitDialogTitle">{\WixUI_Font_Bigger}Установка Aureon завершена</String>
